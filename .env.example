# Copy this file to .env and fill in values from
# Firebase Console -> Project Settings -> General -> Your apps -> Web app.
# These are all PUBLIC/client-safe values — Firebase web config is not a secret,
# security comes from Firestore Rules + Cloud Functions, never from hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to local Firebase emulators instead of production.
VITE_USE_EMULATOR=false
